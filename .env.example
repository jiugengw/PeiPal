# Keep this value private. Do not commit a real API key.
OPENAI_API_KEY=sk-proj-your-key-here
# Supabase public client configuration.
# SUPABASE_ANON_KEY is safe for browser code when Row Level Security is enabled.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only. Never expose this key in browser code or commit a real value.
# Required: the backend cannot start, and its tests fail, without it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Remote MCP bridge for WorkBuddy/ChatGPT-style clients. Each caregiver
# generates their own personal access token on the website ("Connect an
# app") and pastes it into the client's own connector config as its
# bearer token — no separate server-wide secret needed here.
PEIPAL_API_URL=http://127.0.0.1:8000
# MCP_PORT=8001

# Comma-separated browser origins allowed to call the backend API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173

# Static website API origin. For plain HTML, set window.PEIPAL_API_URL
# in the page or keep the local default used by script.js.
# API_BASE_URL=http://127.0.0.1:8000

# Email notifications through Gmail SMTP. PeiPal sends verification codes,
# invitations, approval links, and decision results through this account.
# Use a Google App Password, never the account's normal password.
GMAIL_ADDRESS=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-digit-app-password
GMAIL_FROM_NAME=PeiPal

# Origin used to build the coordination links inside emails. Family members open these without an account, so it must be reachable
# by them. Set it to the deployed frontend origin outside local development.
APP_BASE_URL=http://127.0.0.1:5173
# # Optional: defaults to contacts.json in the current directory.
CONTACTS_FILE=contacts.json
