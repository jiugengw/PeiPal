# Production environment for the separate PeiPal MCP Vercel project.
# Add these values in Vercel Project Settings → Environment Variables.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-real-service-role-key

# Existing PeiPal API deployment.
PEIPAL_API_URL=https://pei-pal.vercel.app

# Frontend origin used for OAuth consent and coordination links.
OAUTH_FRONTEND_URL=https://pei-pal-frontend.vercel.app
CORS_ORIGINS=https://pei-pal-frontend.vercel.app
APP_BASE_URL=https://pei-pal-frontend.vercel.app

# Optional; only needed when running the MCP server locally.
# MCP_PORT=8001
