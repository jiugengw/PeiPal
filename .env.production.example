# Production backend environment. Set these in your hosting provider's secret
# environment-variable settings; do not commit a real copy of this file.
OPENAI_API_KEY=replace-with-real-openai-key
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-real-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-real-supabase-service-role-key

# Public backend/API origin and OAuth consent-page origin.
PEIPAL_API_URL=https://replace-with-api-domain.example.com
OAUTH_FRONTEND_URL=https://replace-with-frontend-domain.example.com
CORS_ORIGINS=https://replace-with-frontend-domain.example.com
APP_BASE_URL=https://replace-with-frontend-domain.example.com

# Email delivery, if enabled in production.
GMAIL_ADDRESS=replace-with-gmail-address
GMAIL_APP_PASSWORD=replace-with-gmail-app-password
GMAIL_FROM_NAME=PeiPal

# Optional local voice-demo setting; not required by the hosted API.
CONTACTS_FILE=contacts.json
